---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import cfg, { conSeccion } from '../../../lib/sitio.js';

export async function getStaticPaths() {
  const items = await getCollection('machetes');
  return conSeccion('machetes').flatMap((inst) =>
    items.filter((e) => inst.unidades.includes(e.data.unidad)).map((e) => ({ params: { instancia: inst.ruta, slug: e.id }, props: { e, inst, modelo: e.id.endsWith('-machete') ? items.find((x) => x.data.unidad === e.data.unidad && x.id.endsWith('-mi-modelo')) : undefined } })));
}
const { e, inst, modelo } = Astro.props;
const { Content, headings } = await render(e);
const slugify = (t) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
// Índice: las tarjetas <Definicion> (su h2 no está en headings) o, si no hay, los ## de la página.
const defs = [...(e.body ?? '').matchAll(/<Definicion\s+titulo="([^"]+)"(?:\s+pts=\{(\d+)\})?/g)].map((m) => ({ text: m[1], slug: slugify(m[1]), pts: m[2] }));
const indice = defs.length ? defs : headings.filter((h) => h.depth === 2);
const base = import.meta.env.BASE_URL;
const archivos = Object.entries(cfg.archivos ?? {});
---
<Layout titulo={e.data.titulo} descripcion={e.data.resumen ?? `${e.data.titulo} · ${cfg.materia.corto}`}>
  <p class="eyebrow"><a href={`${base}${inst.ruta}/machetes/`}>Machetes</a> · {e.data.unidad}</p>
  <h1>{e.data.titulo}</h1>
  {archivos.length > 0 && (
    <p class="suave leyenda-fte">Fuentes: {archivos.map(([c, a], i) => <>{i > 0 && ' · '}<strong>{c}</strong> = {a}</>)}. «p.» = página del archivo. Contenido elaborado para el sitio, no oficial.</p>
  )}
  {modelo && <a class="btn-modelo" href={`${base}${inst.ruta}/machetes/${modelo.id}/`}>MI MODELO →</a>}
  {(defs.length > 0 || indice.length > 2) && (
    <nav class="machete-indice" id="indice-machete" aria-label="Índice de esta página">
      <h2 class="machete-indice-t">En esta página</h2>
      <ol>{indice.map((h) => <li><a href={`#${h.slug}`}><span>{h.text}</span>{h.pts && <small>{h.pts} pts</small>}</a></li>)}</ol>
    </nav>
    <a class="machete-arriba" href="#indice-machete">↑ Índice</a>
  )}
  <article class="lectura machete" data-unidad={e.data.unidad}><Content /></article>
</Layout>
<style is:global>
  .machete { max-width: 100%; min-width: 0; }
  .machete table { font-size: .92rem; }
  .machete .katex-display { overflow-x: auto; overflow-y: hidden; }
  .machete img { max-width: 100%; height: auto; }
  .btn-modelo { display: inline-flex; align-items: center; min-height: 44px; margin: 0 0 14px; padding: 0 20px; border-radius: 99px; background: var(--acento); color: var(--sup); font-weight: 700; letter-spacing: .06em; text-decoration: none; box-shadow: var(--sombra); }
  .btn-modelo:hover { filter: brightness(1.1); }
  .leyenda-fte { font-size: .85rem; max-width: 60rem; }
  .machete td, .machete th { vertical-align: top; }
  .machete-indice ol { list-style: none; padding: 0; columns: 1; display: grid; gap: 4px 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  main .machete-indice { max-width: 46rem; }
  .machete-indice li { padding: 0; }
  .machete-indice a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 6px 12px; border-radius: var(--r-s); text-decoration: none; color: var(--texto); font-size: .95rem; line-height: 1.3; transition: background .15s; }
  .machete-indice a:hover { background: color-mix(in srgb, var(--acento) 9%, var(--sup)); }
  .machete-indice a small { flex: none; font-weight: 700; font-size: .75rem; color: var(--acento); background: color-mix(in srgb, var(--acento) 11%, var(--sup)); border-radius: 99px; padding: 2px 10px; }
  .machete-arriba { position: fixed; right: 16px; bottom: 16px; z-index: 15; display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 99px; background: var(--acento); color: var(--sobre-acento); font-weight: 600; font-size: .9rem; text-decoration: none; box-shadow: var(--sombra-h); opacity: .92; }
  .machete-arriba:hover { opacity: 1; }
</style>
