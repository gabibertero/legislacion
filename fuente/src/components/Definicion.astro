---
// Tarjeta de definición de machete: <Definicion titulo="Persona" pts={20} art="art. 19" desglose={[["Concepto", 8], ["Clases", 6]]}>…</Definicion>
const { titulo, pts, art, desglose = [] } = Astro.props;
// Párrafos que son solo un <strong> ("N. Subtítulo →") se marcan como sub-encabezados.
const cuerpo = (await Astro.slots.render('default')).replace(/<p>(<strong>[^<]*<\/strong>)<\/p>/g, '<p class="def-sub">$1</p>');
const id = titulo.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<section class="def" id={id}>
  <header class="def-cab">
    <h2 class="def-t">{titulo}</h2>
    {art && <span class="def-art">{art}</span>}
    <span class="def-pts" aria-label={`Vale ${pts} puntos`}>{pts} pts</span>
  </header>
  <div class="def-cuerpo"><Fragment set:html={cuerpo} /></div>
  {desglose.length > 0 && (
    <ul class="def-desglose" aria-label="Cómo se reparten los puntos">
      {desglose.map(([q, p]) => <li><span>{q}</span><b>{p}</b></li>)}
    </ul>
  )}
</section>
<style is:global>
  .def { background: var(--sup); border: 0; border-radius: var(--r); box-shadow: 0 1px 2px rgb(60 20 30 / .06), 0 6px 18px rgb(60 20 30 / .07); padding: 1.1rem 1.25rem; margin: 0 0 1.1rem; scroll-margin-top: 5rem; }
  .def-cab { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem .6rem; margin-bottom: .5rem; }
  .machete .def-t { margin: 0; font-size: 1.2rem; flex: 1 1 auto; border: 0; padding: 0; }
  .def-art { font-size: .78rem; font-weight: 600; color: var(--suave); }
  .def-pts { font-size: .8rem; font-weight: 700; color: var(--acento); background: color-mix(in srgb, var(--acento) 11%, var(--sup)); border-radius: 99px; padding: .2rem .7rem; letter-spacing: .01em; white-space: nowrap; }
  .def-cuerpo > :first-child { margin-top: 0; }
  .def-cuerpo > :last-child { margin-bottom: 0; }
  .def-desglose { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: .8rem 0 0; padding: .7rem 0 0; border-top: 1px solid var(--borde); }
  .def-desglose li { display: inline-flex; gap: .4rem; font-size: .8rem; background: var(--sup2); border: 0; border-radius: 99px; padding: .2rem .65rem; margin: 0; }
  .def-desglose b { color: var(--acento); }
  /* ritmo vertical dentro de la tarjeta */
  .lectura .def-cuerpo > * { margin-block: 0 14px; }
  .lectura .def-cuerpo > :last-child { margin-bottom: 0; }
  .lectura .def-cuerpo ul, .lectura .def-cuerpo ol { padding-left: 22px; }
  .lectura .def-cuerpo li { margin: 0 0 6px; }
  .lectura .def-cuerpo li > p { margin: 0 0 6px; }
  .lectura .def-cuerpo > :is(table, .nemo, blockquote) { margin-block: 18px; }
  /* sub-encabezados: párrafo que es solo un <strong> ("N. Subtítulo →") */
  .lectura .def-cuerpo > p.def-sub { margin: 28px 0 10px; padding-top: 14px; border-top: 1px solid var(--borde); font-family: var(--f-ed); font-size: 1.05rem; line-height: 1.3; }
  .lectura .def-cuerpo > p.def-sub > strong { color: var(--acento); font-weight: 700; }
  .lectura .def-cuerpo > p.def-sub:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .lectura .def-cuerpo > p > em:only-child { color: var(--suave); }
  /* tablas: sin partir palabras, primera columna legible */
  .def-cuerpo th, .def-cuerpo td { overflow-wrap: break-word; word-break: normal; hyphens: manual; }
  .def-cuerpo tbody td:first-child { font-weight: 600; min-width: 5.5rem; }
  @media (max-width: 520px) { .def-cuerpo table { font-size: .84rem; } .def-cuerpo th, .def-cuerpo td { padding: 6px 8px; } .def { padding: 1rem 1rem 1.1rem; } }
  /* mnemotecnia: "regla para memorizar" */
  .lectura .nemo { font-size: .92rem; line-height: 1.55; background: color-mix(in srgb, var(--acento) 9%, var(--sup)); border: 1px dashed color-mix(in srgb, var(--acento) 38%, var(--sup)); border-radius: var(--r-s); padding: 10px 14px; }
  .nemo b { color: var(--acento); letter-spacing: .02em; }
  /* aviso (blockquote): ámbar suave, sin borde lateral */
  .lectura .def-cuerpo blockquote { background: var(--generado-fondo); border: 1px solid color-mix(in srgb, var(--generado) 28%, var(--sup)); border-radius: var(--r-s); padding: 10px 14px; font-size: .92rem; line-height: 1.55; }
  .lectura .def-cuerpo blockquote p { margin: 0; }
  /* desglose de puntos */
  .lectura .def-desglose { padding: 14px 0 0; margin: 22px 0 0; gap: 6px; }
  .def-desglose::before { content: 'Cómo se reparten los puntos'; flex: 0 0 100%; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--suave); margin-bottom: 2px; }
  .lectura .def-desglose li { margin: 0; }
</style>
