---
import sitio from '../lib/sitio.js';
import IA from './IA.astro';
// Una pregunta del preguntero. El slot es la respuesta (MDX con KaTeX).
// tema = id de src/data/temas-*.json (progreso por tema en el Home). fr / fq = fuentes con formato "U1:2-3; Ap:167" (código:páginas). parcial = "T1, T2" si cayó en un parcial.
const { id, unidad, titulo, enunciado, literal = false, parcial = '', tema = '', q = '', sim = '', fq = '', fr = '' } = Astro.props;
const ARCH = sitio.archivos ?? {}; // código -> archivo, desde sitio.config.mjs
const fuentes = (s) => s.split(';').map((x) => x.trim()).filter(Boolean).map((x) => {
  const [c, p] = x.split(':');
  return { archivo: ARCH[c] ?? c, p: p?.trim() };
});
// En /top15/ solo se muestran las q="Top N" (en orden N); en el resto del preguntero, todas.
const enTop = Astro.url.pathname.includes('/top15/');
const nTop = Number(q.match(/^Top (\d+)$/)?.[1]) || 0;
const mostrar = !enTop || nTop > 0;
---
{mostrar && <article class:list={['preg', { 'preg-top': enTop }]} style={enTop ? `order:${nTop}` : undefined} data-n={enTop ? nTop : undefined} data-pregunta data-id={id} data-unidad={unidad} data-sim={sim || undefined} id={id} data-ia-ctx data-tema={tema || undefined}>
  <header class="preg-cab">
    <span class="chip chip-u">{unidad}</span>
    {q && <span class="chip">{q}</span>}
    {parcial && <span class="chip chip-fuerte" title="Apareció en un parcial teórico">cayó en {parcial}</span>}
    <span class="chip" data-literal={literal ? 'si' : 'no'}>{literal ? 'enunciado literal' : 'pregunta de práctica'}</span>
    <span class="preg-estado" data-estado-txt aria-live="polite"></span>
  </header>
  <h3 class="preg-tit" data-ia-tit>{titulo}</h3>
  <blockquote class="preg-enun" data-ia-enun>{enunciado}</blockquote>
  {fq && <p class="preg-fte">Pregunta: {fuentes(fq).map((f, i) => <>{i > 0 && ' · '}<em>{f.archivo}</em>{f.p && <>, {/^\d/.test(f.p) ? 'p. ' : ''}{f.p}</>}</>)}</p>}
  {enTop ? (
    // Top 15 = para leer y memorizar: respuesta a la vista. Practicar sin respuesta va en el preguntero/simulacro.
    <>
      <div class="resp lectura-resp" data-ia-modelo><slot /></div>
      {fr && <p class="preg-fte">Respuesta elaborada a partir de: {fuentes(fr).map((f, i) => <>{i > 0 && ' · '}<em>{f.archivo}</em>{f.p && <>, {/^\d/.test(f.p) ? 'p. ' : ''}{f.p}</>}</>)}</p>}
      <IA modo="explicar" />
    </>
  ) : (
    <>
      <IA modo="corregir" />
      <details class="preg-resp" data-resp>
        <summary><span class="s-ver">Mostrar respuesta</span><span class="s-ocultar">Ocultar respuesta</span></summary>
        <div class="resp lectura-resp" data-ia-modelo><slot /></div>
        {fr && <p class="preg-fte">Respuesta elaborada a partir de: {fuentes(fr).map((f, i) => <>{i > 0 && ' · '}<em>{f.archivo}</em>{f.p && <>, {/^\d/.test(f.p) ? 'p. ' : ''}{f.p}</>}</>)}</p>}
      </details>
    </>
  )}
  <div class="preg-acc" data-js hidden role="group" aria-label="Marcar pregunta">
    <button type="button" class="btn-sabe" data-marca="sabe" aria-pressed="false">✓ La sé</button>
    <button type="button" class="btn-repasar" data-marca="repasar" aria-pressed="false">↻ Repasar</button>
  </div>
</article>}
<style is:global>
  .preg { background: var(--sup); border: 1px solid var(--borde); border-top: 5px solid var(--uc, var(--borde-fuerte)); border-radius: var(--r); box-shadow: var(--sombra); padding: 16px 20px 14px; margin: 0 0 1.25rem; min-width: 0; }
  .preg[data-estado='sabe'] { border-color: color-mix(in srgb, var(--e-ok) 45%, var(--borde)); border-top-color: var(--e-ok); }
  .preg[data-estado='repasar'] { border-top-color: var(--generado); }
  .preg-top .preg-tit { font-size: 1.45rem; line-height: 1.25; }
  .preg-top .preg-enun { font-size: 1.05rem; }
  .preg-cab { display: flex; flex-wrap: wrap; align-items: center; gap: 2px; }
  .preg-estado { margin-left: auto; font-size: .82rem; font-weight: 700; color: var(--suave); }
  .preg[data-estado='sabe'] .preg-estado { color: var(--e-ok); }
  .preg[data-estado='repasar'] .preg-estado { color: var(--generado); }
  .preg-tit { margin: .4rem 0 .5rem; font-family: var(--f-ed); font-size: 1.2rem; }
  .preg-enun { margin: 0 0 .6rem; padding: 8px 14px; border-left: 4px solid var(--uc, var(--borde-fuerte)); background: var(--sup2); border-radius: 0 var(--r-s) var(--r-s) 0; font-style: italic; overflow-wrap: anywhere; }
  .preg-fte { margin: .4rem 0 0; font-size: .82rem; color: var(--suave); overflow-wrap: anywhere; }
  .preg-resp { margin: .6rem 0 .4rem; }
  .preg-resp > summary { cursor: pointer; font-weight: 700; min-height: 40px; display: inline-flex; align-items: center; padding: 4px 14px; border: 1px solid var(--acento); border-radius: 999px; color: var(--acento); list-style: none; }
  .preg-resp > summary::-webkit-details-marker { display: none; }
  .preg-resp .s-ocultar, .preg-resp[open] .s-ver { display: none; }
  .preg-resp[open] .s-ocultar { display: inline; }
  .resp { margin-top: .75rem; padding: 4px 16px 10px; border: 1px solid var(--borde); border-left: 4px solid var(--elaborado); background: var(--elaborado-fondo); border-radius: var(--r-s); overflow-x: auto; max-width: 100%; }
  .resp::before { content: 'Respuesta elaborada para el sitio — no oficial'; display: block; margin: 6px 0 4px; font-size: .78rem; font-weight: 700; color: var(--elaborado); text-transform: uppercase; letter-spacing: .03em; }
  .resp .katex-display { overflow-x: auto; overflow-y: hidden; padding: 2px 0; }
  .resp table { display: block; overflow-x: auto; border-collapse: collapse; max-width: 100%; }
  .resp th, .resp td { border: 1px solid var(--borde-fuerte); padding: 5px 9px; vertical-align: top; }
  .resp img { max-width: 100%; height: auto; }
  .preg-acc { display: flex; flex-wrap: wrap; gap: 8px; margin-top: .6rem; }
  .preg-acc button { min-height: 40px; padding: 6px 16px; border-radius: 999px; border: 1px solid var(--borde-fuerte); background: var(--sup2); color: var(--texto); font: inherit; font-weight: 600; cursor: pointer; }
  .preg-acc button[aria-pressed='true'].btn-sabe { background: var(--e-ok-bg); color: var(--e-ok); border-color: var(--e-ok); }
  .preg-acc button[aria-pressed='true'].btn-repasar { background: var(--generado-fondo); color: var(--generado); border-color: var(--generado); }
  .preg-acc button:focus-visible, .preg-resp > summary:focus-visible { outline: 3px solid var(--link); outline-offset: 2px; }
  @media (max-width: 520px) { .preg { padding: 14px 14px 12px; } .resp { padding: 4px 10px 8px; } }
</style>
