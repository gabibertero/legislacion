---
// Figura de teoría (public/figuras/teoria/<nombre>.svg). alt descriptivo obligatorio.
const { src, alt, pie = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<figure class="fig-teo">
  <img src={`${base}figuras/teoria/${src}.svg`} alt={alt} loading="lazy" />
  {pie && <figcaption>{pie}</figcaption>}
</figure>
<style is:global>
  .fig-teo { margin: .8rem 0; text-align: center; }
  .fig-teo img { max-width: 100%; height: auto; background: #fff; border: 1px solid var(--borde-fuerte); border-radius: var(--r-s); padding: 6px; }
  .fig-teo figcaption { font-size: .85rem; color: var(--suave); margin-top: 4px; }
</style>
